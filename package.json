    "ink": "^7.0.5",
    "marked": "^18.0.5",
    "marked-terminal": "^7.3.0",
    "react": "^19.2.7",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/marked-terminal": "^6.1.1",
    "@types/react": "^19.2.17"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
