{
  "name": "persoje",
  "version": "0.1.0",
  "description": "Token-efficient agentic coding CLI for OpenRouter — lean harness, smart routing, weak-model guardrails",
  "type": "module",
  "private": true,
  "bin": {
    "persoje": "src/cli.ts"
